# Environment overrides for starmap-service.
# Copy to .env and adjust. Anything set here overrides config/config.yaml.

# MQTT broker
MQTT_BROKER=localhost
MQTT_PORT=1883

# Rendering
# STARMAP_RESOLUTION=2600

# Output delivery: file (default) | base64
# STARMAP_OUTPUT_MODE=file

# Logging
# LOG_LEVEL=INFO

# Headless matplotlib (required; set by Docker/systemd, here for reference)
# MPLBACKEND=Agg
